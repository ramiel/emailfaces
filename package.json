{
  "name": "emailfaces",
  "version": "1.0.0",
  "description": "Resolve the avatar associated with an email address from multiple sources (Gravatar, Libravatar, GitLab, GitHub, …) with rate-limit handling.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "keywords": [
    "avatar",
    "email",
    "gravatar",
    "libravatar",
    "github",
    "gitlab",
    "rxjs"
  ],
  "author": "",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.18.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "rxjs": "^7.8.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "rxjs": "^7.8.0"
  }
}
