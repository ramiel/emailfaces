{
  "name": "emailfaces",
  "version": "1.1.0",
  "description": "Resolve the avatar associated with an email address from multiple sources (Gravatar, Libravatar, GitLab, GitHub, …) with rate-limit handling.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "try": "tsc -p tsconfig.json && node dist/cli.js",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "keywords": [
    "avatar",
    "email",
    "gravatar",
    "libravatar",
    "github",
    "gitlab"
  ],
  "author": "Fabrizio Ruggeri",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ramiel/emailfaces.git"
  },
  "homepage": "https://github.com/ramiel/emailfaces#readme",
  "bugs": {
    "url": "https://github.com/ramiel/emailfaces/issues"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.18.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./rxjs": {
      "types": "./dist/rxjs.d.ts",
      "import": "./dist/rxjs.js"
    }
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "emailfaces": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": [
    "./dist/cli.js"
  ]
}
